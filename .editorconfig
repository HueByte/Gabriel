# .editorconfig — what the editor WRITES. Mirrors .gitattributes (what git
# STORES: LF, UTF-8, final newline) so editor output, git storage, and the CI
# Format Check gate (`dotnet format --verify-no-changes`, which reads this
# file as its style source) are byte-identical. Change a style rule here and
# both the editor and the gate follow — never in two places.

root = true

# ============================================================================
# Defaults
# ============================================================================
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# ============================================================================
# C# — kept aligned with the default `dotnet format` conventions so the CI
# gate stays green out of the box; preferences are suggestions, not blocks.
# ============================================================================
[*.cs]
indent_size = 4

# Newline / brace conventions (Allman, the .NET default)
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true

# Style preferences — nudge, don't block
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion
csharp_prefer_braces = true:suggestion
csharp_style_namespace_declarations = file_scoped:suggestion
dotnet_style_qualification_for_field = false:suggestion
dotnet_sort_system_directives_first = true

# Naming: async methods end in Async — CLAUDE.md states it, this enforces it.
dotnet_naming_rule.async_methods_end_in_async.symbols = async_methods
dotnet_naming_rule.async_methods_end_in_async.style = end_in_async
dotnet_naming_rule.async_methods_end_in_async.severity = suggestion
dotnet_naming_symbols.async_methods.applicable_kinds = method
dotnet_naming_symbols.async_methods.required_modifiers = async
dotnet_naming_style.end_in_async.required_suffix = Async
dotnet_naming_style.end_in_async.capitalization = pascal_case

# ============================================================================
# Project / solution XML — 2-space (the ecosystem norm)
# ============================================================================
[*.{csproj,slnx,props,targets,xml}]
indent_size = 2

# ============================================================================
# Frontend — 2-space
# ============================================================================
[*.{ts,tsx,js,jsx,json,css,html}]
indent_size = 2

# ============================================================================
# Infrastructure / scripts
# ============================================================================
[*.{yml,yaml,toml,sh}]
indent_size = 2

[*.ps1]
indent_size = 4

[Dockerfile*]
indent_size = 2

# ============================================================================
# Markdown — two trailing spaces are a legitimate hard-break marker; never
# strip them.
# ============================================================================
[*.md]
trim_trailing_whitespace = false

# ============================================================================
# Generated / vendored — reformatting machine output is churn; the formatter
# and the CI gate skip these.
# ============================================================================
[**/{node_modules,bin,obj}/**]
indent_style = unset
indent_size = unset

# EF Core migrations are generated by `dotnet ef migrations add` — never
# hand-formatted, never hand-edited.
[src/api/Gabriel.Infrastructure/Migrations/**.cs]
generated_code = true
